# Daemon and engine: non-secret settings, same in every environment
ENGINE_ANTIGINX_CALL=/app/cli-app
PIPE_COMMUNICATION=true
PROMETHEUS_PORT=:5000
RABBITMQ_QUEUE_NAME=scan_queue
RABBITMQ_RESULTS_QUEUE=results_queue

# Daemon: optional settings
# PREFETCH_COUNT=12
# TASK_CHANNEL_SIZE=10
# WORKER_POOL=10
# ANTIGINX_NVD_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# ANTIGINX_RDAP_URL=https://rdap.org
# ANTIGINX_URLHAUS_URL=https://urlhaus-api.abuse.ch
