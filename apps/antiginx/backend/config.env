# Backend: non-secret settings, same in every environment
GIN_MODE=release
TRUSTED_PROXIES=10.42.0.0/16
RABBITMQ_RESULTS_QUEUE=results_queue
PROMETHEUS_URL=http://prometheus-operated.monitoring.svc:9090
PUBLIC_BASE_URL=https://DOMAIN
GRAFANA_URL=https://grafana.DOMAIN

