{
  "title": "Daemon",
  "uid": "antiginx-daemon",
  "tags": [
    "antiginx"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "links": [
    {
      "title": "Antiginx",
      "type": "dashboards",
      "tags": [
        "antiginx"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Wdrożenia",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "step": "1m",
        "expr": "changes(kube_deployment_status_observed_generation{namespace=~\"antiginx|data\"}[2m]) > 0",
        "titleFormat": "Wdrożenie: {{deployment}}",
        "tagKeys": "deployment"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Stan",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Działające daemony",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"daemon-service\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Zajęte workery",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(daemon_active_workers) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Skuteczność skanów (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((increase(engine_scan_outcomes_total{status=\"complete\"}[24h]) and engine_scan_outcomes_total{status=\"complete\"} offset 24h) or engine_scan_outcomes_total{status=\"complete\"})) / sum(((increase(engine_scan_outcomes_total[24h]) and engine_scan_outcomes_total offset 24h) or engine_scan_outcomes_total))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Błędy wewnętrzne (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((increase(daemon_internal_errors_total[24h]) and daemon_internal_errors_total offset 24h) or daemon_internal_errors_total)) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "links": [
        {
          "title": "Logi: daemon",
          "url": "/d/antiginx-logs/logs?var-app=daemon&${__url_time_range}"
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Skany",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Skany na godzinę wg wyniku",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (((increase(engine_scan_outcomes_total[1h]) and engine_scan_outcomes_total offset 1h) or engine_scan_outcomes_total))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "links": [
            {
              "title": "Logi: daemon",
              "url": "/d/antiginx-logs/logs?var-app=daemon&${__url_time_range}"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "complete"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "incomplete"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Zajęte workery",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(daemon_active_workers)",
          "legendFormat": "workery"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Logi: daemon",
              "url": "/d/antiginx-logs/logs?var-app=daemon&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Średni czas skanu (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (((increase(engine_scan_duration_seconds_sum[1h]) and engine_scan_duration_seconds_sum offset 1h) or engine_scan_duration_seconds_sum)) / sum (((increase(engine_scan_duration_seconds_count[1h]) and engine_scan_duration_seconds_count offset 1h) or engine_scan_duration_seconds_count))",
          "legendFormat": "średnio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [
            {
              "title": "Logi: daemon",
              "url": "/d/antiginx-logs/logs?var-app=daemon&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "bargauge",
      "title": "Najwolniejsze testy (średnio, 1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (test) (((increase(engine_test_duration_seconds_sum[1h]) and engine_test_duration_seconds_sum offset 1h) or engine_test_duration_seconds_sum)) / sum by (test) (((increase(engine_test_duration_seconds_count[1h]) and engine_test_duration_seconds_count offset 1h) or engine_test_duration_seconds_count)))",
          "legendFormat": "{{test}}",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      }
    },
    {
      "type": "row",
      "title": "Podatności",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Podatności wg poziomu (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (threat_level) (((increase(engine_vulnerabilities_found_total{threat_level!~\"None|Info\"}[24h]) and engine_vulnerabilities_found_total{threat_level!~\"None|Info\"} offset 24h) or engine_vulnerabilities_found_total{threat_level!~\"None|Info\"}))",
          "legendFormat": "{{threat_level}}",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "High"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Medium"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Low"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "title": "Podatności w czasie wg poziomu",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (threat_level) (((increase(engine_vulnerabilities_found_total{threat_level!~\"None|Info\"}[1h]) and engine_vulnerabilities_found_total{threat_level!~\"None|Info\"} offset 1h) or engine_vulnerabilities_found_total{threat_level!~\"None|Info\"}))",
          "legendFormat": "{{threat_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "High"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Medium"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Low"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 23
      }
    },
    {
      "type": "bargauge",
      "title": "Testy z największą liczbą podatności – top 10 (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (test) (((increase(engine_vulnerabilities_found_total{threat_level!~\"None|Info\"}[24h]) and engine_vulnerabilities_found_total{threat_level!~\"None|Info\"} offset 24h) or engine_vulnerabilities_found_total{threat_level!~\"None|Info\"})))",
          "legendFormat": "{{test}}",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      }
    },
    {
      "type": "row",
      "title": "Błędy",
      "id": 15,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Błędy wewnętrzne na godzinę",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component, code) (((increase(daemon_internal_errors_total[1h]) and daemon_internal_errors_total offset 1h) or daemon_internal_errors_total))",
          "legendFormat": "{{component}} / {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Logi: daemon",
              "url": "/d/antiginx-logs/logs?var-app=daemon&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      }
    },
    {
      "type": "timeseries",
      "title": "Ponowienia publikacji do RabbitMQ na godzinę",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((increase(daemon_rabbit_publish_retries_total[1h]) and daemon_rabbit_publish_retries_total offset 1h) or daemon_rabbit_publish_retries_total)) or vector(0)",
          "legendFormat": "ponowienia"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Logi: daemon",
              "url": "/d/antiginx-logs/logs?var-app=daemon&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "id": 17,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      }
    }
  ]
