{
  "title": "Traffic",
  "uid": "antiginx-traffic",
  "tags": [
    "antiginx"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "links": [
    {
      "title": "Antiginx",
      "type": "dashboards",
      "tags": [
        "antiginx"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Wdrożenia",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "step": "1m",
        "expr": "changes(kube_deployment_status_observed_generation{namespace=~\"antiginx|data\"}[2m]) > 0",
        "titleFormat": "Wdrożenie: {{deployment}}",
        "tagKeys": "deployment"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Certyfikat TLS",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Certyfikat wygasa za",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(traefik_tls_certs_not_after{cn!=\"TRAEFIK DEFAULT CERT\"}) - time()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 604800
              },
              {
                "color": "green",
                "value": 1814400
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Let's Encrypt odnawia certyfikat około 30 dni przed wygaśnięciem. Poniżej 21 dni odnowienie nie zadziałało.",
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "table",
      "title": "Certyfikaty",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cn, sans) (traefik_tls_certs_not_after{cn!=\"TRAEFIK DEFAULT CERT\"}) - time()",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations"
        }
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Wygasa za",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Wygasa za",
              "Value #A": "Wygasa za"
            }
          }
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 16,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Ruch",
      "id": 4,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Żądania (zakres)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((increase(traefik_entrypoint_requests_total{entrypoint=\"websecure\"}[$__range]) and traefik_entrypoint_requests_total{entrypoint=\"websecure\"} offset $__range) or traefik_entrypoint_requests_total{entrypoint=\"websecure\"}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 7
      }
    },
    {
      "type": "stat",
      "title": "Błędy 5xx (zakres)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((increase(traefik_entrypoint_requests_total{entrypoint=\"websecure\", code=~\"5..\"}[$__range]) and traefik_entrypoint_requests_total{entrypoint=\"websecure\", code=~\"5..\"} offset $__range) or traefik_entrypoint_requests_total{entrypoint=\"websecure\", code=~\"5..\"})) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 7
      }
    },
    {
      "type": "stat",
      "title": "Odsetek błędów 5xx (zakres)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(((increase(traefik_entrypoint_requests_total{entrypoint=\"websecure\", code=~\"5..\"}[$__range]) and traefik_entrypoint_requests_total{entrypoint=\"websecure\", code=~\"5..\"} offset $__range) or traefik_entrypoint_requests_total{entrypoint=\"websecure\", code=~\"5..\"})) or vector(0)) / sum(((increase(traefik_entrypoint_requests_total{entrypoint=\"websecure\"}[$__range]) and traefik_entrypoint_requests_total{entrypoint=\"websecure\"} offset $__range) or traefik_entrypoint_requests_total{entrypoint=\"websecure\"}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 7
      }
    },
    {
      "type": "stat",
      "title": "Otwarte połączenia",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(traefik_open_connections{entrypoint=\"websecure\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "W tym WebSockety podglądu skanu na żywo.",
      "id": 8,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Żądania na sekundę wg usługi",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(traefik_service_requests_total[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      }
    },
    {
      "type": "timeseries",
      "title": "Żądania na sekundę wg kodu odpowiedzi",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{entrypoint=\"websecure\"}[$__rate_interval]))",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      }
    },
    {
      "type": "timeseries",
      "title": "Czas odpowiedzi p95 wg usługi",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traefik_service_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "Przekierowania HTTP → HTTPS",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_entrypoint_requests_total{entrypoint=\"web\"}[$__rate_interval]))",
          "legendFormat": "http"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      }
    }
  ]
}