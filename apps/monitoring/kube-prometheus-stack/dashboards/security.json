{
  "title": "Security",
  "uid": "antiginx-security",
  "tags": [
    "antiginx"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "links": [
    {
      "title": "Antiginx",
      "type": "dashboards",
      "tags": [
        "antiginx"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Wdrożenia",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "step": "1m",
        "expr": "changes(kube_deployment_status_observed_generation{namespace=~\"antiginx|data\"}[2m]) > 0",
        "titleFormat": "Wdrożenie: {{deployment}}",
        "tagKeys": "deployment"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Logowanie",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Udane logowania",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"antiginx\", app=\"backend\"} |= \"[GIN]\" | regexp `\\| (?P<status>\\d{3}) \\| +\\S+ \\| +(?P<ip>\\S+) \\| (?P<method>[A-Z]+) +\"(?P<path>[^\"?]+)` | label_format path=`{{ regexReplaceAll \"[0-9a-f-]{16,}\" .path \":id\" }}` | path =~ \"/api/auth/(login|mfa/verify|webauthn/login/verify)\" | status == 200 [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Nieudane logowania (401)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"antiginx\", app=\"backend\"} |= \"[GIN]\" | regexp `\\| (?P<status>\\d{3}) \\| +\\S+ \\| +(?P<ip>\\S+) \\| (?P<method>[A-Z]+) +\"(?P<path>[^\"?]+)` | label_format path=`{{ regexReplaceAll \"[0-9a-f-]{16,}\" .path \":id\" }}` | path =~ \"/api/auth/(login|mfa/verify|webauthn/login/verify)\" | status == 401 [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "links": [
        {
          "title": "Logi: backend",
          "url": "/d/antiginx-logs/logs?var-app=backend&${__url_time_range}"
        }
      ],
      "description": "Złe hasło, zły kod MFA albo nieudany klucz passkey.",
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
