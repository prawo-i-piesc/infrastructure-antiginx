{
  "title": "Overview",
  "uid": "antiginx-overview",
  "tags": [
    "antiginx"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "links": [
    {
      "title": "Antiginx",
      "type": "dashboards",
      "tags": [
        "antiginx"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Wdrożenia",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "step": "1m",
        "expr": "changes(kube_deployment_status_observed_generation{namespace=~\"antiginx|data\"}[2m]) > 0",
        "titleFormat": "Wdrożenie: {{deployment}}",
        "tagKeys": "deployment"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Stan",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Niedostępne repliki",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_deployment_status_replicas_unavailable{namespace=~\"antiginx|data\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Repliki w antiginx i data, które nie są gotowe. 0 = wszystko działa.",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Restarty kontenerów (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"antiginx|data\"}[24h])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Błędy w logach (zakres)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=~\"antiginx|data\"} |~ \"(?i)(error|fatal|panic|exception)\" [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "links": [
        {
          "title": "Otwórz logi",
          "url": "/d/antiginx-logs/logs?${__url_time_range}"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Ostatni udany backup",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - kube_cronjob_status_last_successful_time{namespace=\"data\", cronjob=\"postgres-backup-cronjob\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              },
              {
                "color": "red",
                "value": 180000
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Ile czasu minęło od ostatniego udanego backupu Postgresa. Backup działa codziennie o 03:00.",
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Backend",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Żądania (zakres)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"antiginx\", app=\"backend\"} |= \"[GIN]\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "stat",
      "title": "Błędy 5xx (zakres)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"antiginx\", app=\"backend\"} |= \"[GIN]\" | regexp `\\| (?P<status>\\d{3}) \\|` | status >= 500 [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "links": [
        {
          "title": "Logi: backend",
          "url": "/d/antiginx-logs/logs?var-app=backend&${__url_time_range}"
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 6
      }
    },
    {
      "type": "stat",
      "title": "Błędy 4xx (zakres)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"antiginx\", app=\"backend\"} |= \"[GIN]\" | regexp `\\| (?P<status>\\d{3}) \\|` | status >= 400 | status < 500 [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 9,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 6
      }
    },
    {
      "type": "stat",
      "title": "Czas odpowiedzi p95 (zakres)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {namespace=\"antiginx\", app=\"backend\"} |= \"[GIN]\" | regexp `\\| +(?P<latency>[0-9.]+[µnm]?s) +\\|` | unwrap duration(latency) [$__range]) by (app)",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 10,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Żądania wg statusu",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (count_over_time({namespace=\"antiginx\", app=\"backend\"} |= \"[GIN]\" | regexp `\\| (?P<status>\\d{3}) \\|` [$__auto]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          },
          "links": [
            {
              "title": "Logi: backend",
              "url": "/d/antiginx-logs/logs?var-app=backend&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Czas odpowiedzi (p50 / p95)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {namespace=\"antiginx\", app=\"backend\"} |= \"[GIN]\" | regexp `\\| +(?P<latency>[0-9.]+[µnm]?s) +\\|` | unwrap duration(latency) [$__auto]) by (app)",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.50, {namespace=\"antiginx\", app=\"backend\"} |= \"[GIN]\" | regexp `\\| +(?P<latency>[0-9.]+[µnm]?s) +\\|` | unwrap duration(latency) [$__auto]) by (app)",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [
            {
              "title": "Logi: backend",
              "url": "/d/antiginx-logs/logs?var-app=backend&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      }
    },
    {
      "type": "table",
      "title": "Najczęstsze endpointy (zakres)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (path) (count_over_time({namespace=\"antiginx\", app=\"backend\"} |= \"[GIN]\" | regexp `\\| +[A-Z]+ +\"(?P<path>[^\"?]+)` | label_format path=`{{ regexReplaceAll \"[0-9a-f-]{16,}\" .path \":id\" }}` [$__range])))",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Żądania",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Żądania",
              "Value #A": "Żądania"
            }
          }
        }
      ],
      "id": 13,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "table",
      "title": "Najwolniejsze endpointy p95 (zakres)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, quantile_over_time(0.95, {namespace=\"antiginx\", app=\"backend\"} |= \"[GIN]\" | regexp `\\| +[A-Z]+ +\"(?P<path>[^\"?]+)` | label_format path=`{{ regexReplaceAll \"[0-9a-f-]{16,}\" .path \":id\" }}` | regexp `\\| +(?P<latency>[0-9.]+[µnm]?s) +\\|` | unwrap duration(latency) [$__range]) by (path))",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "p95",
              "Value #A": "p95"
            }
          }
        }
      ],
      "id": 14,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      }
    },
    {
      "type": "row",
      "title": "Skaner",
      "id": 15,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Skany (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((increase(engine_scan_outcomes_total[24h]) and engine_scan_outcomes_total offset 24h) or engine_scan_outcomes_total)) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "links": [
        {
          "title": "Dashboard Daemon",
          "url": "/d/antiginx-daemon/daemon?${__url_time_range}"
        }
      ],
      "id": 16,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 28
      }
    },
    {
      "type": "stat",
      "title": "Skuteczność skanów (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(((increase(engine_scan_outcomes_total{status=\"complete\"}[24h]) and engine_scan_outcomes_total{status=\"complete\"} offset 24h) or engine_scan_outcomes_total{status=\"complete\"})) / sum(((increase(engine_scan_outcomes_total[24h]) and engine_scan_outcomes_total offset 24h) or engine_scan_outcomes_total))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 17,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 28
      }
    },
    {
      "type": "stat",
      "title": "Zajęte workery daemona",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(daemon_active_workers) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
