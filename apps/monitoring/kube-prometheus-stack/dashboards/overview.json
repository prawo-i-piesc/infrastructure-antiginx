    {
      "type": "row",
      "title": "Zasoby",
      "id": 19,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU wg kontenera",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=~\"antiginx|data\", container!=\"\", container!=\"POD\"}[$__rate_interval]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "links": [
            {
              "title": "Logi tego kontenera",
              "url": "/d/antiginx-logs/logs?var-app=${__field.labels.container}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "id": 20,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      }
    },
    {
      "type": "timeseries",
      "title": "Pamięć wg kontenera",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=~\"antiginx|data\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "links": [
            {
              "title": "Logi tego kontenera",
              "url": "/d/antiginx-logs/logs?var-app=${__field.labels.container}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "id": 21,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      }
    },
    {
      "type": "gauge",
      "title": "Wolne miejsce na dysku VPS",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Dysk główny, na którym leży /var/lib/antiginx (Postgres, Prometheus, Loki, Grafana).",
      "targets": [
        {
          "refId": "A",
          "expr": "min(node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.15
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 22,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 41
      }
    },
    {
      "type": "table",
      "title": "Wdrożone wersje",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, container, image) (kube_pod_container_info{namespace=~\"antiginx|data\"})",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Pody",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {
              "Value": "Pody",
              "Value #A": "Pody"
            }
          }
        }
      ],
      "id": 23,
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 41
      }
    }
  ]
