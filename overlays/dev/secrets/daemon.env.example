# Required
RABBITMQ_URL=amqp://<RABBITMQ_DEFAULT_USER>:<RABBITMQ_DEFAULT_PASS>@rabbitmq-service.data.svc.cluster.local:5672/

# Allow private targets, true or false (must match backend.env)
ANTIGINX_ALLOW_PRIVATE_TARGETS=true

# Optional: without it the urlhaus test is skipped
# ANTIGINX_URLHAUS_AUTH_KEY=<ANTIGINX_URLHAUS_AUTH_KEY>

# Optional: raises the NVD rate limit for CVE lookups
# ANTIGINX_NVD_API_KEY=<ANTIGINX_NVD_API_KEY>
