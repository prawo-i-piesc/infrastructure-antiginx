# Required
DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres-service.data.svc.cluster.local:5432/<POSTGRES_DB>?sslmode=disable
RABBITMQ_URL=amqp://<RABBITMQ_DEFAULT_USER>:<RABBITMQ_DEFAULT_PASS>@rabbitmq-service.data.svc.cluster.local:5672/
JWT_SECRET=<JWT_SECRET>
TOTP_ENCRYPTION_KEY=<TOTP_ENCRYPTION_KEY>

# Allow private targets, true or false
ANTIGINX_ALLOW_PRIVATE_TARGETS=false

# Mail: resend, log or none
MAIL_TRANSPORT=resend
# MAIL_FROM=<MAIL_FROM>
# RESEND_API_KEY=<RESEND_API_KEY>

# Optional: OAuth, each pair must be set together
# GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
# GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
# GITHUB_CLIENT_ID=<GITHUB_CLIENT_ID>
# GITHUB_CLIENT_SECRET=<GITHUB_CLIENT_SECRET>

# Optional: Stripe billing for the Pro plan, key and price must be set together
# STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
# STRIPE_PRO_PRICE_ID=<STRIPE_PRO_PRICE_ID>
# STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>
